base(href='/')
meta(lang='en')
meta(charset='utf-8')
meta(name='revision' content=GIT_REVISION || 'HEAD')
meta(name='description' content=pkg.description)
meta(name='author' content=pkg.author.name)
meta(http-equiv='X-UA-Compatible' content='IE=edge,chrome=1')
meta(name='HandheldFriendly' content='true')
meta(name='viewport' content='width=device-width, initial-scale=1,maximum-scale=1,user-scalable=no')

link(rel='preconnect' href='https://fonts.googleapis.com')
link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
link(href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Rajdhani:wght@400;500;600;700&display=swap' rel='stylesheet')

<!--[if lt IE 9]>
script(src='//html5shim.googlecode.com/svn/trunk/html5.js')
script(src='//css3-mediaqueries-js.googlecode.com/svn/trunk/css3-mediaqueries.js')
<![endif]-->

-
  const siteUrl = 'https://soypache.co'
  const pageDescription = typeof og_description !== 'undefined' ? og_description : pkg.description
  const pageImage = typeof og_image !== 'undefined' ? og_image : 'images/soypache-og.jpg'
  const pageImageUrl = /^https?:\/\//.test(pageImage) ? pageImage : `${siteUrl}/${String(pageImage).replace(/^\/+/, '')}`
  const pageUrl = typeof og_url !== 'undefined' ? og_url : pkg.author.url
  const pageImageAlt = typeof og_image_alt !== 'undefined' ? og_image_alt : pageDescription

meta(property='og:type' content='profile')
meta(property='og:site_name' content=pkg.name)
meta(property='og:profile:first_name' content=pkg.author.name.split(' ')[0])
meta(property='og:profile:last_name' content=pkg.author.name.split(' ')[1])
meta(property='og:profile:username' content=pkg.author.email.split('@')[0])
meta(property='og:profile:gender' content='male')
meta(property='og:description' content=pageDescription)
meta(property='og:url' content=pageUrl)
meta(property='og:image' content=pageImageUrl)
meta(property='og:image:type' content='image/jpeg')
meta(property='og:image:width' content='1200')
meta(property='og:image:height' content='630')
meta(property='og:image:alt' content=pageImageAlt)
meta(name='twitter:card' content='summary_large_image')
meta(name='twitter:image' content=pageImageUrl)
meta(name='twitter:image:alt' content=pageImageAlt)
meta(name='twitter:description' content=pageDescription)

block styles
  link(rel='stylesheet' type='text/css' href='styles.css')

block meta
  if title
    meta(property='og:title' content=title)
    meta(name='twitter:title' content=title)

block head
  if title
    title= title

if G4_TOKEN && NODE_ENV === 'production'
  script(async src=`https://www.googletagmanager.com/gtag/js?id=${G4_TOKEN}`)
  script.
    /* eslint-disable */
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '#{G4_TOKEN}');
    /* eslint-enable */
